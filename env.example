# 复制本文件为 .env，然后填入真实值（.env 已在 .gitignore 中，不会被提交）

# SteamDT 开放平台 API Key
# 申请地址：https://open.steamdt.com
STEAMDT_API_KEY=your_api_key_here

# MySQL 连接配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=steamdt_db
DB_USER_RO=your_readonly_user
DB_PASS_RO=your_readonly_password
DB_USER_RW=your_readwrite_user
DB_PASS_RW=your_readwrite_password
